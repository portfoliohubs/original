rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // ADMIN VERIFICATION LOGIC
    // =========================================================================
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in [
          'cources01@gmail.com',
          'admin@portfoliohubs.com'
        ] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@portfoliohubs[.]com$')) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // Helper: Checks if the user is authenticated and matches the owner UID
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // =========================================================================
    // 1. DOCTOR PROFILE DATA (/users/{uid})
    // =========================================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || (resource.data.status == 'approved' || resource.data.status == 'published');
      allow create: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();

      // Clinical cases subcollection
      match /cases/{caseId} {
        allow read: if isOwner(uid) || isAdmin() || get(/databases/$(database)/documents/users/$(uid)).data.status in ['approved', 'published'];
        allow create, update, delete: if isOwner(uid) || isAdmin();
      }

      // Temporary pending uploads
      match /pending_uploads/{uploadId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    // =========================================================================
    // 2. BLOG ARTICLES (/blog_articles/{slug})
    // =========================================================================
    match /blog_articles/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 3. PUBLICATION & REVIEW STATUS (/publications/{uid})
    // =========================================================================
    match /publications/{uid} {
      allow read: if isOwner(uid) || isAdmin() || (resource.data.status == 'approved' || resource.data.status == 'published');
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. SLUG REGISTRY (/slugs/{slug})
    // =========================================================================
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
    }

    // =========================================================================
    // 5. ADMIN ALLOWLIST (/admins/{email})
    // =========================================================================
    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. GLOBAL SETTINGS (/settings/{docId})
    // =========================================================================
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. PORTFOLIOS & PACKAGES (Backward Compatibility)
    // =========================================================================
    match /portfolios/{uid} {
      allow read: if isOwner(uid) || isAdmin() || (resource.data.status == 'approved' || resource.data.status == 'published');
      allow write: if isOwner(uid) || isAdmin();
    }
    match /published_portfolios/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /packages/{tier} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
